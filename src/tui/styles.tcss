/*
 * Enhancify Textual Stylesheet (TCSS)
 * Single-source theming: every theme swaps a ~14-value `$enh-*` token
 * palette (see src/theme.py:css_variables) instead of duplicating CSS
 * per theme. EnhancifyApp.get_css_variables() supplies the active
 * theme's values; EnhancifyApp.apply_theme() re-resolves the stylesheet
 * live on switch.
 */

/* ====================================================
   BASE COMMON LAYOUT & WIDGETS
   ==================================================== */

Screen {
    background: $enh-bg;
    color: $enh-text;
}

#cyber-header {
    /* The outer CyberHeader widget does the docking; this inner container
       must stay in normal flow (a nested dock:top collapsed the header
       to a single row). */
    height: auto;
    background: $enh-surface;
    border-bottom: solid $enh-accent;
    padding: 0 1;
}

#header-title {
    width: 1fr;
    text-align: center;
    text-style: bold;
    color: $enh-accent;
}

CyberStatusBar {
    background: $enh-bg;
    border-bottom: solid $enh-border;
}

.status-nav-hint {
    color: $enh-muted;
}

#status-bar-badges {
    layout: horizontal;
    align-horizontal: center;
    height: auto;
    margin-top: 0;
    margin-bottom: 0;
}

/* Stacked override MUST beat the #id selector above (same specificity+class). */
#status-bar-badges.stacked {
    layout: vertical;
    align-horizontal: center;
}

#status-bar-badges.stacked .badge {
    margin: 0 0 1 0;
    width: auto;
}

/* === RESPONSIVE BUTTON BAR (never overflow beyond display) === */
ButtonBar {
    layout: horizontal;
    height: auto;
    width: 1fr;
    margin-bottom: 1;
}

ButtonBar.stacked {
    layout: vertical;
}

ButtonBar.stacked Button {
    width: 1fr;
    min-width: 0;
    margin-right: 0;
}

ButtonBar Button {
    width: auto;
    min-width: 0;
    max-width: 100%;
}

/* Dialog button rows use ButtonBar too — stack vertically when narrow. */
.dialog-buttons.stacked {
    layout: vertical;
    align-horizontal: center;
}

.dialog-buttons.stacked Button {
    width: 1fr;
    min-width: 0;
    margin-right: 0;
}

.download-cancel-row.stacked {
    layout: vertical;
    align-horizontal: center;
}

.badge {
    padding: 0 1;
    margin: 0 1;
    text-style: bold;
    border: round $enh-border;
    background: $enh-surface;
    color: $enh-muted;
}

.badge-green {
    border: round $enh-accent;
    color: $enh-accent;
    background: $enh-surface;
}

.badge-cyan {
    border: round $enh-accent-2;
    color: $enh-accent-2;
    background: $enh-surface;
}

.badge-purple {
    border: round $enh-tag;
    color: $enh-tag;
    background: $enh-surface;
}

.badge-yellow {
    border: round $enh-warning;
    color: $enh-warning;
    background: $enh-surface;
}

.container-box {
    padding: 1;
    height: 1fr;
    overflow-y: auto;
}

ContentContainer {
    scrollbar-color: $enh-accent;
    scrollbar-color-hover: $enh-accent-2;
}

/* Detail cards (patch info, gmscore/pothelper/specs/token summaries) are
   VerticalScroll: focusable so arrow-key focus-nav can reach them, and
   scrollable so arrows/pageup/pagedown then scroll their content once
   focused (including horizontal scroll for content that cannot wrap). */
.detail-card {
    height: auto;
    max-height: 100%;
    min-height: 5;
    overflow-y: auto;
    overflow-x: auto;
}

.detail-card:focus {
    border: round $enh-accent-2;
}

/* Cards that host a ListView size to their content (bounded) instead of
   filling the whole viewport, so cards below them (e.g. changelog) stay
   reachable within the outer ContentContainer's scroll area. */
.list-card {
    height: auto;
    max-height: 100%;
    min-height: 8;
    overflow-y: auto;
}

.list-card ListView {
    height: auto;
    max-height: 12;
    min-height: 5;
}

.list-card ListView > ListItem > Label {
    width: 1fr;
}

.card {
    background: $enh-surface;
    border: round $enh-border;
    padding: 1;
    margin-bottom: 1;
    height: auto;
}

/* Nested Vertical groups (e.g. button stacks) inside a card must size to
   their content, not fill 1fr — otherwise the card (and the scrollable
   ContentContainer around it) never sees a true content height and the
   scrollbar can never detect overflow. */
.card Vertical {
    height: auto;
}

.card:focus {
    border: round $enh-accent;
}

.card-title {
    text-style: bold;
    color: $enh-accent;
    margin-bottom: 0;
}

.card-desc {
    color: $enh-muted;
    margin-bottom: 1;
}

Button {
    background: $enh-surface;
    color: $enh-text;
    border: round $enh-border;
    height: 3;
    min-width: 16;
    max-width: 100%;
    margin: 0 1 1 0;
    text-style: bold;
}

/* Buttons stacked in a plain Vertical column always fill the row width
   so long labels can never push beyond the display (truncated instead). */
Vertical > Button {
    width: 1fr;
    min-width: 0;
    max-width: 100%;
    margin-right: 0;
}

Button:hover {
    background: $enh-border;
    border: round $enh-accent;
    color: $enh-on-dark;
}

Button:focus {
    background: $enh-btn-focus-bg;
    border: round $enh-accent;
    color: $enh-btn-focus-fg;
}

Button.btn-primary {
    background: $enh-btn-bg;
    border: round $enh-accent;
    color: $enh-accent;
}

Button.btn-primary:focus {
    background: $enh-accent;
    color: $enh-btn-focus-fg;
}

Button.btn-danger {
    background: #490202;
    border: round $enh-danger;
    color: #ff6666;
}

Button.btn-danger:focus {
    background: $enh-danger;
    color: $enh-on-dark;
}

Button.btn-secondary {
    background: #1f242c;
    border: round $enh-muted;
    color: $enh-muted;
}

ListView {
    background: $enh-surface-2;
    border: round $enh-border;
    height: 1fr;
    padding: 0;
}

ListItem {
    padding: 0 1;
    background: $enh-surface;
    border-bottom: solid #21262d;
}

ListItem:hover {
    background: #21262d;
}

ListItem:focus {
    background: $enh-row-focus-bg;
    color: $enh-row-focus-fg;
}

ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}

.dialog-box {
    width: 85%;
    max-width: 70;
    height: auto;
    max-height: 85%;
    background: $enh-surface;
    border: round $enh-accent;
    padding: 1 2;
    overflow-y: auto;
}

.dialog-title {
    text-style: bold;
    color: $enh-accent;
    border-bottom: solid $enh-border;
    padding-bottom: 1;
    margin-bottom: 1;
    text-align: center;
}

.dialog-message {
    color: $enh-muted;
    margin-bottom: 1;
}

.dialog-buttons {
    layout: horizontal;
    align-horizontal: center;
    margin-top: 1;
    height: auto;
}

Input {
    background: $enh-surface-2;
    border: round $enh-border;
    color: $enh-accent;
    margin-bottom: 1;
}

Input:focus {
    border: round $enh-accent;
}

#log-viewer {
    background: $enh-log-bg;
    border: round $enh-accent;
    color: $enh-log-fg;
    height: 1fr;
    padding: 1;
    overflow-y: auto;
}

ProgressBar {
    margin: 1 0;
}

Bar > .bar--bar {
    color: $enh-accent;
    background: $enh-row-focus-bg;
}

Bar > .bar--complete {
    color: $enh-accent;
}


/* === DOWNLOAD / PARSE PROGRESS (gradient) === */
.download-dialog {
    width: 90%;
    max-width: 72;
    min-width: 40;
}

.download-meta {
    color: $enh-muted;
    text-align: left;
    margin-bottom: 0;
}

.download-detail {
    color: $enh-muted;
    text-align: center;
    height: 1;
    margin-top: 0;
    margin-bottom: 0;
}

.download-cancel-row {
    layout: horizontal;
    align-horizontal: center;
    align: center middle;
    width: 100%;
    margin-top: 1;
    height: auto;
}

.download-cancel-row Button {
    min-width: 16;
}

.btn-danger {
    background: #3d1219;
    color: #ff7b72;
    border: tall #f85149;
    text-style: bold;
}

.btn-danger:hover {
    background: #f85149;
    color: #0d1117;
}

GradientProgressBar {
    height: 1;
    width: 100%;
    margin: 1 0 0 0;
}

GradientSpinner {
    height: 1;
    width: 100%;
    content-align: center middle;
    margin: 1 0 0 0;
}

/* ====================================================
   SMALL CENTRED DIALOGS (patch details / toggles / appearance / modules)
   ==================================================== */
.small-dialog {
    width: 60%;
    max-width: 56;
    max-height: 85%;
}

.changelog-dialog {
    width: 75%;
    max-width: 78;
    max-height: 88%;
}

.changelog-meta {
    text-style: bold;
    margin-bottom: 1;
}

.desc-scroll {
    height: auto;
    max-height: 14;
    min-height: 4;
    border: round $enh-border;
    background: $enh-surface-2;
    padding: 0 1;
    margin-bottom: 1;
    overflow-y: auto;
}

.desc-text {
    color: $enh-muted;
}

#patch-dialog-name {
    margin-bottom: 1;
}

/* --- Toggle (animated switch) dialog --- */
.toggle-scroll {
    max-height: 16;
    min-height: 4;
    border: round $enh-border;
    background: $enh-surface-2;
    padding: 1 0;
    margin-bottom: 1;
    overflow-y: auto;
}

.toggle-scroll CyberSwitch {
    margin-bottom: 0;
}

.toggle-scroll CyberSwitch:hover {
    background: #131c26;
}

/* --- Preset-choice select dialog (patch option "values") --- */
.select-scroll {
    max-height: 16;
    min-height: 4;
    border: round $enh-border;
    background: $enh-surface-2;
    padding: 1 0;
    margin-bottom: 1;
    overflow-y: auto;
}

/* --- Modules dialog (stacked button list) --- */
.modules-list {
    layout: vertical;
    align-horizontal: center;
    margin-bottom: 1;
}
.modules-list Button {
    width: 100%;
    max-width: 40;
    margin-bottom: 1;
}

/* --- Download batch rows (aria2c simultaneous mixedgauge) --- */
.batch-rows {
    margin-bottom: 0;
}

/* --- Appearance dialog palette bar --- */
#theme-palette {
    height: 1;
}

/* ====================================================
   BOOT SCREEN (Enhancify Rebranded)
   ==================================================== */
#boot-screen {
    height: 1fr;
    width: 1fr;
    align: center middle;
    background: $enh-bg;
}

#boot-art {
    color: $enh-accent;
    text-style: bold;
    text-align: center;
    margin-bottom: 1;
}

#boot-brand {
    color: $enh-accent-2;
    text-style: bold;
    text-align: center;
    margin-bottom: 0;
}

#boot-name {
    color: $enh-warning;
    text-style: bold italic;
    text-align: center;
    margin-bottom: 2;
}

#boot-info {
    color: $enh-muted;
    text-align: center;
    margin-bottom: 1;
}

#boot-hint {
    color: $enh-muted;
    text-align: center;
    margin-top: 1;
    text-style: dim;
}

#boot-bar {
    width: 44;
    max-width: 90%;
}

/* ====================================================
   CYBER STATUS BAR (main menu top)
   ==================================================== */
.status-bar-item {
}
